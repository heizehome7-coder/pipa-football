{
  "name": "pipa-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "sim": "tsx scripts/sim.ts",
    "typecheck": "tsc --noEmit",
    "server": "node server/realtime-server.mjs",
    "online": "npm run build && node server/realtime-server.mjs",
    "test:lobby": "tsx scripts/lobby-test.ts",
    "start": "node server/realtime-server.mjs",
    "test:match": "tsx scripts/match-test.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
